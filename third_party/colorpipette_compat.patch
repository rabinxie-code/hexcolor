diff --git a/src/flask/third_party/cython/connectivity.py b/src/flask/third_party/cython/connectivity.py
new file mode 100644
--- /dev/null
+++ b/src/flask/third_party/cython/connectivity.py
@@
+"""Compatibility shim for the repository's CPython 3.6-only extension."""
+import numpy as np
+from skimage.segmentation._slic import _enforce_label_connectivity_cython
+
+def enforce_connectivity(segments, min_size, max_size):
+    return _enforce_label_connectivity_cython(
+        np.asarray(segments, dtype=np.intp), int(min_size), int(max_size), start_label=0
+    )
